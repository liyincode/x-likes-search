{
  "name": "x-likes-search",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:visual": "playwright test",
    "test:perf": "node --test tests/perf/feed-render.bench.js",
    "test:perf:input": "playwright test --config=playwright.perf.config.js",
    "test": "npm run typecheck && npm run test:unit && npm run test:visual"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3"
  }
}
